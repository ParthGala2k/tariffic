# Copy to .env and fill in. Never commit .env.
# Keys per handover (CLAUDE.md) section 9.

# --- LLM provider ---
# Which brain the seat agents use: creao (the Brewline agents on Creao) | openai | anthropic
# With creao, LLM_MODEL_FAST plus an ANTHROPIC_API_KEY or OPENAI_API_KEY still serve the small
# classification calls; the seats themselves run on the three agents below.
LLM_PROVIDER=creao

# Model ids are read from here only; the code never hardcodes them.
LLM_MODEL=
LLM_MODEL_FAST=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Claude API ---
ANTHROPIC_API_KEY=

# --- Stripe (test mode only) ---
STRIPE_SECRET_KEY=sk_test_...

# --- Increase (sandbox only) ---
INCREASE_API_KEY=
INCREASE_BASE_URL=https://sandbox.increase.com

# --- Local systems of record ---
MOCKOON_URL=http://localhost:3001
BEANCOUNT_FILE=systems/books/main.beancount
ERP_DB=systems/erp/erp.db
DESK_DB=systems/desk/desk.db

# --- Creao agents (brewline_agents_integration.md); app-scoped capi_ keys ---
CREAO_TARIFFS_REFUNDS_KEY=
CREAO_SOURCING_KEY=
CREAO_STOCK_CUSTOMERS_KEY=
# CREAO_BASE_URL=https://agent.creao.ai
# CREAO_RUN_TIMEOUT=300
# CREAO_DRY_RUN=1   # answer from the recorded transcripts; no network, no credit
